{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/app-entry.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app-ssr.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|webp|svg|ico|webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://grontho-bilash-server.vercel.app/api/v1/seo/sitemap.xml"
    },
    {
      "source": "/api-proxy/:path*",
      "destination": "https://grontho-bilash-server.vercel.app/api/v1/:path*"
    },
    {
      "source": "/blogs/:slug",
      "destination": "https://grontho-bilash-server.vercel.app/api/v1/seo/blog-page/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
